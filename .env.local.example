# Supabase project settings — Project Settings > API in the Supabase dashboard.

# Safe to expose to the browser — used for public reads only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# --- Server-only below this line — never prefix with NEXT_PUBLIC_ ---

# Full-privilege key (bypasses Row Level Security). The admin panel uses a
# single shared password rather than per-user Supabase Auth, so there's no
# auth.uid() for RLS to check against on writes — this key is how the
# already-password-gated Server Actions perform them instead. Never let this
# reach the browser or a client component.
SUPABASE_SECRET_KEY=your-secret-key

# The admin panel's login password (/admin/login). Pick your own — this is
# not a Supabase value. Generate one with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_PASSWORD=change-me

# --- Push notifications (admin panel "new message" alerts) ---
# Native push only (Capacitor Android app) — there's no browser Web Push
# path anymore, so nothing here is NEXT_PUBLIC_. These back
# src/app/api/notify-admin/route.ts, which the Supabase DB trigger in
# supabase/migrations/0015_notify_trigger_points_to_nextjs_route.sql calls
# whenever a new contact_messages row is inserted.

# Any random string YOU generate — must match the value baked into the
# 0015 migration's trigger function exactly.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WEBHOOK_SECRET=change-me

# From the Firebase service account JSON (Firebase Console > Project
# settings > Service accounts > Generate new private key). Keep the private
# key's \n sequences escaped exactly as they appear in the downloaded JSON —
# the route un-escapes them at runtime.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Android app self-updater (admin Settings > "نوێکردنەوەی ئەپ") ---
# Backs src/app/api/app-version/route.ts. The installed APK polls it and
# offers an in-app update when APP_LATEST_VERSION_CODE is higher than its
# own. Leave APP_LATEST_VERSION_CODE / APP_APK_URL unset and the panel just
# says "no update yet" — it never nags.
#
# Release flow: bump versionCode + versionName in android/app/build.gradle,
# run `npm run android:release`, upload the signed
# android/app/build/outputs/apk/release/app-release.apk somewhere public
# (e.g. a Supabase Storage public bucket), then set the four vars below to
# match and redeploy.
APP_LATEST_VERSION_CODE=2
APP_LATEST_VERSION_NAME=1.1
APP_APK_URL=https://your-project-ref.supabase.co/storage/v1/object/public/app/app-release.apk
APP_UPDATE_NOTES=

# --- Visitor analytics (admin dashboard "visitor stats" section) ---
# Used to HMAC-hash visitor IPs before storing them, so "unique visitor"
# counts can be estimated without ever persisting a raw IP address. Any
# random string YOU generate — losing/rotating it just resets the unique-
# visitor dedup, nothing else breaks.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ANALYTICS_IP_SALT=change-me
